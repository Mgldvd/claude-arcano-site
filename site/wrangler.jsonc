// The site is static: `nuxt generate` writes .output/public and the Worker serves it as assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-arcano-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./.output/public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "claude.arcano.site", "custom_domain": true }]
}
